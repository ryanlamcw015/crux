# Copy this file to backend/.env (or .env here) and fill in real values. Never commit .env.

# Database. Leave unset to use a local SQLite file (backend/crux.db).
# Production: a PostgreSQL URL with PostGIS available, e.g. from Neon:
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Signs login tokens. Required in production. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Frontend URL(s) allowed to call the API (comma-separated)
FRONTEND_ORIGIN=http://localhost:5173
# Optional: regex for extra allowed origins, e.g. Vercel preview deployments
# FRONTEND_ORIGIN_REGEX=https://crux-web-.*\.vercel\.app
